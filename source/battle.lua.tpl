-- Skaven lore-firendly (no) friendly fire --VERSION--
-- Skaven ranged units no longer hold fire because chosen friendly units stand in the line of fire.
-- Needs memreader Plus. Fail-safe: if anything does not match this game build, the mod does nothing.
--
-- How it works: the game asks, for every soldier near the line of fire, "would this shot hit you?" before it lets a
-- unit shoot. A small piece of machine code (a "code cave") is placed at the point of that question where the game
-- has just found out that the soldier in the way is an ally. For a listed Skaven shooter and a listed friendly unit
-- the answer becomes "no". The flight of the real projectile is not changed, so the shot can still hit that unit.

local MOD = 'skaven_lore_friendly_fire'
local VERSION = '--VERSION--'
local SKAVEN = 'wh2_main_sc_skv_skaven'
local REFRESH_MS = 2000
local TIMER = MOD .. '_refresh'

--GAMECODE--

-- generated by build.py from cave.py (do not edit by hand) ----------------------------------------------------------
local CAVE_A = '--CAVE_A--'
local CAVE_B = '--CAVE_B--'
local CAVE_C = '--CAVE_C--'
local TABLE_SIZE = --TABLE_SIZE--
local OFF_ENABLE = --OFF_ENABLE--
local OFF_ALL = --OFF_ALL--
local OFF_COUNT = --OFF_COUNT-- --@debug
local OFF_SHOOTERS = --OFF_SHOOTERS--
local OFF_BLOCKERS = --OFF_BLOCKERS--
local MAX_SHOOTERS = --MAX_SHOOTERS--
local MAX_BLOCKERS = --MAX_BLOCKERS--
-- end of generated part -------------------------------------------------------------------------------------------

local DEFAULTS = { sst_expendable = true, sst_clanrats = false, sst_infantry = false, sst_monstrous = false, sst_all = false }
local ZERO8 = '\0\0\0\0\0\0\0\0'

-- CA replaced string.find and string.sub with UTF-8 versions; the plain ones are kept under these names
local find = string.find_lua or string.find
local sub = string.sub_lua or string.sub

local mr = nil -- memreader Plus, set in start()
local state = {
	dead = false, -- true = the mod stays off for this battle
	loc = nil, -- addresses found in the game code
	tbl = nil, -- table the cave reads
	signature = nil, -- what the table holds while it is switched on
	buffer = nil,
	announced = false,
}

local function log(message)
	if type(ModLog) == 'function' then pcall(ModLog, '[' .. MOD .. '] ' .. tostring(message)) end
end

--@debug-begin
-- TEST BUILD ONLY (build.py --debug, pack !skaven_lore_friendly_fire_debug, never uploaded): everything is also written
-- to a file in the game folder, with the settings, the units involved and how often the cave answered "shoot through".
local LOG_FILE = 'skaven_lore_friendly_fire_log.txt'
local OPTION_ORDER = { 'sst_expendable', 'sst_clanrats', 'sst_infantry', 'sst_monstrous', 'sst_all' }
local debug_state = { started = false, idle = nil, count = 0 }
local modlog = log
log = function(message)
	modlog(message)
	local file = io.open(LOG_FILE, debug_state.started and 'a' or 'w')
	debug_state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

local function settings_text(settings)
	local parts = {}
	for _, key in ipairs(OPTION_ORDER) do
		parts[#parts + 1] = key .. '=' .. tostring(settings[key])
	end
	return table.concat(parts, ' ')
end

local function key_counts(entries)
	local counts, order = {}, {}
	for _, entry in ipairs(entries) do
		if not counts[entry.key] then order[#order + 1] = entry.key end
		counts[entry.key] = (counts[entry.key] or 0) + 1
	end
	local parts = {}
	for _, key in ipairs(order) do
		parts[#parts + 1] = counts[key] .. 'x ' .. key
	end
	return table.concat(parts, ', ')
end

local function log_count(always)
	if not state.tbl then return end
	local count = mr.read_uint32(state.tbl, OFF_COUNT)
	if always or count ~= debug_state.count then log('line-of-fire checks answered "shoot through" so far: ' .. tostring(count)) end
	debug_state.count = count
end
--@debug-end

local function has(text, part)
	return find(text, part, 1, true) ~= nil
end

-- settings ------------------------------------------------------------------------------------------------------

local function read_settings()
	local settings = {}
	for key, value in pairs(DEFAULTS) do
		settings[key] = value
	end
	if type(get_mct) ~= 'function' then return settings, 'defaults, no Mod Configuration Tool' end
	local ok = pcall(function()
		local mct_mod = get_mct():get_mod_by_key(MOD)
		if not mct_mod then return end
		for key in pairs(DEFAULTS) do
			local option = mct_mod:get_option_by_key(key)
			local value = option and option:get_finalized_setting()
			if type(value) == 'boolean' then settings[key] = value end
		end
	end)
	return settings, ok and 'Mod Configuration Tool' or 'defaults, settings could not be read'
end

-- Is the unit infantry? The game's own answer; false when the game cannot say.
local function is_infantry(unit)
	local ok, value = pcall(function() return unit:is_infantry() end)
	return ok and value == true
end

-- which MCT option covers a unit, by its key (the option "All infantry" goes by is_infantry instead)
local function category(key)
	if has(key, 'skavenslave') or has(key, 'pusbag') then return 'sst_expendable' end
	if has(key, 'clanrat') then return 'sst_clanrats' end
	if has(key, 'rat_ogres') or has(key, 'stormfiend') then return 'sst_monstrous' end
	return nil
end

-- cave and table ----------------------------------------------------------------------------------------------------

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

-- the table of the cave that is already at the site (from an earlier battle of this game session), or nil
local function existing_table()
	local info = mr.hook_info(state.loc.site)
	if not info then return nil end
	if info.kind ~= 'cave' or not info.cave then error('something else already hooks the cave site (' .. tostring(info.kind) .. ')', 0) end
	local length = #CAVE_A + 8 + #CAVE_B + 8 + #CAVE_C
	local bytes = mr.read(info.cave, 0, length)
	local b_from = #CAVE_A + 8 + 1
	local c_from = b_from + #CAVE_B + 8
	if #bytes ~= length or sub(bytes, 1, #CAVE_A) ~= CAVE_A or sub(bytes, b_from, b_from + #CAVE_B - 1) ~= CAVE_B or sub(bytes, c_from) ~= CAVE_C then
		error('the cave at the site is not from this version of the mod', 0)
	end
	if sub(bytes, c_from - 8, c_from - 1) ~= raw8(state.loc.ret) then error('the cave at the site jumps somewhere unexpected', 0) end
	local tbl = mr.read_pointer(info.cave, #CAVE_A)
	if mr.is_null(tbl) then error('the cave at the site has no table', 0) end
	return tbl
end

local function install()
	local tbl = mr.game_alloc(TABLE_SIZE) -- zeroed, never freed: the cave stays for the game session and reads it
	local code = CAVE_A .. raw8(tbl) .. CAVE_B .. raw8(state.loc.ret) .. CAVE_C
	mr.code_cave(state.loc.site, code)
	if existing_table() ~= tbl then error('the cave was not installed as written', 0) end
	log('code cave installed (' .. #code .. ' bytes)') --@debug
	return tbl
end

local function switch_off()
	state.signature = nil
	if state.tbl then mr.write(state.tbl, OFF_ENABLE, mr.uint32(0)) end
end

local function write_list(offset, list)
	for index, pointer in ipairs(list) do
		mr.write(state.tbl, offset + 8 * (index - 1), pointer)
	end
	mr.write(state.tbl, offset + 8 * #list, ZERO8)
end

-- units -----------------------------------------------------------------------------------------------------------

-- The game's Unit object behind a script unit ("mov rcx,[rsi+8]" in the game's unique_ui_id script function),
-- confirmed by reading the unit's id out of it.
local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.loc.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

-- the Skaven units of the battle: those that can shoot, and those the settings let them shoot through
local function wanted_units(settings)
	local shooters, blockers = {}, {}
	local function visit(units, skaven_army)
		for index = 1, units:count() do
			local unit = units:item(index)
			local key = string.lower(tostring(unit:type()))
			if skaven_army or has(key, '_skv_') then
				local entry = { unit = unit, key = key }
				if unit:starting_ammo() > 0 then shooters[#shooters + 1] = entry end
				local kind = category(key)
				if (kind and settings[kind]) or (settings.sst_infantry and is_infantry(unit)) then blockers[#blockers + 1] = entry end
			end
		end
	end
	local alliances = bm.battle:alliances()
	for a = 1, alliances:count() do
		local armies = alliances:item(a):armies()
		for b = 1, armies:count() do
			local army = armies:item(b)
			local skaven_army = army:subculture_key() == SKAVEN
			visit(army:units(), skaven_army)
			for r = 1, army:num_reinforcement_units() do
				visit(army:get_reinforcement_units(r), skaven_army)
			end
		end
	end
	return shooters, blockers
end

-- the confirmed Unit objects of the entries (at most limit), and a text that changes when the list changes
local function pointers_of(entries, limit)
	local list, texts, seen = {}, {}, {}
	for _, entry in ipairs(entries) do
		if #list >= limit then break end -- the rest keeps the normal behaviour
		local pointer = unit_pointer(entry.unit)
		if not pointer then error('the game object of unit ' .. entry.key .. ' could not be confirmed', 0) end
		local text = mr.tostring(pointer)
		if not seen[text] then
			seen[text] = true
			list[#list + 1] = pointer
			texts[#texts + 1] = text
		end
	end
	return list, table.concat(texts, ',')
end

local function refresh(reason)
	local settings, source = read_settings()
	local shooters, blockers = wanted_units(settings)
	local all = settings.sst_all == true
	if #shooters == 0 or not (all or #blockers > 0) then
		switch_off()
		--@debug-begin
		local idle = ('nothing to do (Skaven shooters: %d, units to shoot through: %d; %s; %s)'):format(#shooters, #blockers, settings_text(settings), source)
		if idle ~= debug_state.idle then log(reason .. ': ' .. idle) end
		debug_state.idle = idle
		--@debug-end
		return
	end
	local shooter_list, shooter_text = pointers_of(shooters, MAX_SHOOTERS)
	local blocker_list, blocker_text = {}, ''
	if not all then
		blocker_list, blocker_text = pointers_of(blockers, MAX_BLOCKERS)
	end
	-- the game code is only touched once every unit has been confirmed
	if not state.tbl then state.tbl = install() end
	local signature = tostring(all) .. '|' .. shooter_text .. '|' .. blocker_text
	if signature == state.signature then return end
	switch_off()
	write_list(OFF_SHOOTERS, shooter_list)
	write_list(OFF_BLOCKERS, blocker_list)
	mr.write(state.tbl, OFF_ALL, mr.uint32(all and 1 or 0))
	mr.write(state.tbl, OFF_ENABLE, mr.uint32(1))
	state.signature = signature
	if not state.announced then
		state.announced = true
		log(('ON: %d Skaven shooters, shooting through %s'):format(#shooter_list, all and 'every friendly unit' or (#blocker_list .. ' units')))
	end
	--@debug-begin
	debug_state.idle = nil
	log(('%s: table written. %s (%s)'):format(reason, settings_text(settings), source))
	log('  Skaven shooters (' .. #shooter_list .. '): ' .. key_counts(shooters))
	log('  shoot through' .. (all and ': every friendly unit' or (' (' .. #blocker_list .. '): ' .. key_counts(blockers))))
	--@debug-end
end

-- start -----------------------------------------------------------------------------------------------------------

local function give_up(reason)
	state.dead = true
	pcall(switch_off)
	log('OFF for this battle: ' .. tostring(reason))
end

-- a callback that switches the mod off for the battle if anything in it fails
local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then give_up(name .. ': ' .. tostring(problem)) end
	end
end

local function start()
	log('Skaven lore-firendly (no) friendly fire ' .. VERSION .. ' TEST BUILD, battle script loaded') --@debug
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded (it is a required mod)', 0) end
	state.loc = locate(mr)
	log(('memreader Plus %s, game code found, unit id offset 0x%x'):format(tostring(mr.plus_version), state.loc.uid_offset)) --@debug

	-- a cave from an earlier battle of this session still lists that battle's units: switch it off before anything else
	state.tbl = existing_table()
	switch_off()
	--@debug-begin
	if state.tbl then
		debug_state.count = mr.read_uint32(state.tbl, OFF_COUNT)
		log('code cave from an earlier battle of this session found, reusing it')
	end
	--@debug-end

	-- Nothing else happens while the battle loads: the Mod Configuration Tool only has the saved settings from the
	-- deployment phase on (seen in game), and nothing shoots before that. The timer also covers a battle that
	-- should have no deployment phase.
	for _, phase in ipairs({ 'Deployment', 'Deployed' }) do
		bm:register_phase_change_callback(
			phase,
			guarded(phase, function()
				refresh('phase ' .. phase)
			end)
		)
	end
	local ticks = 0 --@debug
	bm:repeat_callback(
		guarded('refresh', function()
			refresh('refresh')
			--@debug-begin
			ticks = ticks + 1
			if ticks % 15 == 0 then log_count(false) end
			--@debug-end
		end),
		REFRESH_MS,
		TIMER
	)
	bm:register_phase_change_callback('Complete', function()
		pcall(log_count, true) --@debug
		state.dead = true
		pcall(switch_off)
		pcall(function()
			bm:remove_callback(TIMER)
		end)
		log('battle complete, switched off') --@debug
	end)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
